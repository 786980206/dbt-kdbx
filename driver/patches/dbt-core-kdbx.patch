@@ -0,0 +1,136 @@
+use crate::{AdapterConfig, Auth, AuthError, AuthOutcome, auth_configure_pipeline};
+use database::Builder as DatabaseBuilder;
+use dbt_adbc::{Backend, database};
+use std::borrow::Cow;
+
+const DEFAULT_HOST: &str = "localhost";
+const DEFAULT_PORT: &str = "5000";
+
+#[derive(Debug)]
+enum KdbxAuthIR<'a> {
+    Uri {
+        host: &'a str,
+        port: Cow<'a, str>,
+        username: Option<&'a str>,
+        password: Option<&'a str>,
+    },
+}
+
+impl<'a> KdbxAuthIR<'a> {
+    pub fn apply(self, mut builder: DatabaseBuilder) -> Result<DatabaseBuilder, AuthError> {
+        match self {
+            Self::Uri {
+                host,
+                port,
+                username,
+                password,
+            } => {
+                let uri = format!("kdbx://{host}:{port}");
+                builder.with_parse_uri(uri)?;
+                if let Some(username) = username {
+                    builder.with_username(username);
+                }
+                if let Some(password) = password {
+                    builder.with_password(password);
+                }
+            }
+        }
+
+        Ok(builder)
+    }
+}
+
+fn parse_auth<'a>(config: &'a AdapterConfig) -> Result<KdbxAuthIR<'a>, AuthError> {
+    Ok(KdbxAuthIR::Uri {
+        host: config.get_str("host").unwrap_or(DEFAULT_HOST),
+        port: config
+            .get_string("port")
+            .unwrap_or(Cow::Borrowed(DEFAULT_PORT)),
+        username: config.get_str("username"),
+        password: config.get_str("password"),
+    })
+}
+
+fn apply_connection_args(
+    _config: &AdapterConfig,
+    builder: DatabaseBuilder,
+) -> Result<DatabaseBuilder, AuthError> {
+    Ok(builder)
+}
+
+pub struct KdbxAuth;
+
+impl Auth for KdbxAuth {
+    fn backend(&self) -> Backend {
+        Backend::Kdbx
+    }
+
+    fn configure(&self, config: &AdapterConfig) -> Result<AuthOutcome, AuthError> {
+        auth_configure_pipeline!(self.backend(), &config, parse_auth, apply_connection_args)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::test_options::uri_value;
+    use dbt_test_primitives::assert_contains;
+    use dbt_yaml::Mapping;
+
+    #[test]
+    fn test_defaults() {
+        let config = Mapping::from_iter([]);
+
+        let builder = KdbxAuth {}
+            .configure(&AdapterConfig::new(config))
+            .expect("configure")
+            .builder;
+
+        let uri = uri_value(&builder);
+        assert_contains!(&uri, "kdbx://localhost:5000");
+    }
+
+    #[test]
+    fn test_custom_host_port() {
+        let config = Mapping::from_iter([
+            ("host".into(), "q.prod.internal".into()),
+            ("port".into(), "19500".into()),
+        ]);
+
+        let builder = KdbxAuth {}
+            .configure(&AdapterConfig::new(config))
+            .expect("configure")
+            .builder;
+
+        let uri = uri_value(&builder);
+        assert_contains!(&uri, "kdbx://q.prod.internal:19500");
+    }
+
+    #[test]
+    fn test_numeric_port() {
+        let config = Mapping::from_iter([("port".into(), 19500i64.into())]);
+
+        let builder = KdbxAuth {}
+            .configure(&AdapterConfig::new(config))
+            .expect("configure")
+            .builder;
+
+        let uri = uri_value(&builder);
+        assert_contains!(&uri, "kdbx://localhost:19500");
+    }
+
+    #[test]
+    fn test_credentials() {
+        let config = Mapping::from_iter([
+            ("username".into(), "dev".into()),
+            ("password".into(), "secret".into()),
+        ]);
+
+        let builder = KdbxAuth {}
+            .configure(&AdapterConfig::new(config))
+            .expect("configure")
+            .builder;
+
+        assert_eq!(uri_value(&builder), "kdbx://localhost:5000");
+    }
+}
