+fn kdbx_get_relation(
+    adapter: &AdapterImpl,
+    conn: &mut dyn Connection,
+    database: &str,
+    schema: &str,
+    identifier: &str,
+) -> AdapterResult<Option<Box<dyn BaseRelation>>> {
+    match conn.get_table_schema(Some(database), Some(schema), identifier) {
+        Ok(_) => Ok(Some(Box::new(
+            Relation::new(
+                AdapterType::Kdbx,
+                database.to_string(),
+                Some(schema.to_string()),
+                identifier.to_string(),
+            )
+            .with_relation_type(RelationType::Table)
+            .with_quoting(adapter.quoting())
+            .validate()?,
+        ))),
+        Err(_) => Ok(None),
+    }
