@@ -0,0 +1,75 @@
+-- dbt-kdbx (kdb+/KDB-X) adapter macros.
+--
+-- dbt models compile to q expressions that are evaluated on the q server
+-- (the server-side `AdbcStatementExecuteQuery`/`AdbcStatementExecuteUpdate`
+-- run `value` on the given string). There is no SQL DDL on kdb+: a "table" is
+-- just a global q variable, so every materialization reduces to a q
+-- assignment.
+--
+-- Rules of thumb:
+-- * create_table_as / create_view_as return the q assignment as the macro
+--   body (no `statement()` call); the materialization runs it as the main
+--   query and expects a table back.
+-- * drop/rename/schema operations are side-effecting DDL; they must be
+--   wrapped in `{% call statement(...) %}` so dbt actually executes them
+--   (via the update path, which expects a scalar).
+
+{% macro kdbx__create_table_as(temporary, relation, sql) -%}
+  {{ relation.identifier }}: {{ sql }}; {{ relation.identifier }}
+{%- endmacro %}
+
+{% macro kdbx__create_view_as(relation, sql) -%}
+  {{ relation.identifier }}: {{ sql }}; {{ relation.identifier }}
+{%- endmacro %}
+
+{% macro kdbx__drop_relation(relation) -%}
+  {% call statement('drop_relation', auto_begin=False) -%}
+    value "delete {{ relation.identifier }} from `."; 0
+  {%- endcall %}
+{% endmacro %}
+
+{% macro kdbx__rename_relation(from_relation, to_relation) -%}
+  {% call statement('rename_relation', auto_begin=False) -%}
+    {{ to_relation.identifier }}: {{ from_relation.identifier }}; value "delete {{ from_relation.identifier }} from `."; 0
+  {%- endcall %}
+{% endmacro %}
+
+-- kdb+ has no SQL schema concept; a q variable lives in the root namespace.
+-- These are no-ops that still produce a queryable scalar for the DDL path.
+{% macro kdbx__create_schema(relation) -%}
+  {% call statement('create_schema') -%}
+    0
+  {%- endcall %}
+{% endmacro %}
+
+{% macro kdbx__drop_schema(relation) -%}
+  {% call statement('drop_schema') -%}
+    0
+  {%- endcall %}
+{% endmacro %}
+
+{% macro kdbx__list_schemas(database) -%}
+  ([] a:())
+{%- endmacro %}
+
+{% macro kdbx__check_schema_exists(information_schema, schema) -%}
+  ([] a:())
+{%- endmacro %}
+
+{% macro kdbx__get_columns_in_relation(relation) -%}
+  {{ return([]) }}
+{%- endmacro %}
+
